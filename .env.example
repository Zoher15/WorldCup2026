# Copy to .env.local for local dev, and set the same values in Vercel
# (Project → Settings → Environment Variables). Never commit real secrets.

# --- Supabase (Project → Settings → API) ---
# Safe to expose to the browser:
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only: full access, used by API routes and the recompute job.
# NEVER prefix with NEXT_PUBLIC and never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Live scores ---
# Server-only. The poller uses this; it must never reach the client.
# football-data.org token (free account) — free final scores for the World Cup.
FOOTBALL_DATA_TOKEN=your-football-data-token

# --- Security ---
# Random secret that the live-score poll endpoint requires, so only our
# scheduler (Supabase cron / external cron) can trigger a poll.
CRON_SECRET=generate-a-long-random-string

# Shared passcode for the /admin results-entry page. If unset, admin access is
# disabled. Pick something only you (and any trusted co-admins) know.
ADMIN_PASSCODE=choose-a-strong-passcode

# Public base URL of the app (used for share links and email links).
NEXT_PUBLIC_APP_URL=https://worldcup.kachwalas.com

# --- Email (Resend) ---
# Server-only. Powers the match-day digest email (one consolidated "your
# predictions" email per member ~1h before the day's first kickoff) and the
# sign-in codes. If RESEND_API_KEY is unset, no emails are sent.
# Get a key at resend.com and verify your sending domain for EMAIL_FROM.
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=World Cup 2026 <noreply@worldcup.kachwalas.com>
# All outbound email rides one queue, drained by a single-flight, rate-limited
# drainer that paces requests under Resend's cap (a batch of up to 100 messages
# counts as ONE request, so the real throughput is this x100 emails/sec). Set
# this to your account's real requests/second limit (Resend's default is 2; this
# account is raised to 5). To confirm your limit, set EMAIL_DEBUG_RATELIMIT=1 and
# check the logged ratelimit-limit / ratelimit-reset headers.
EMAIL_RATE_PER_SEC=5
# Legacy: the old login-only queue still drains in parallel during the
# transition; this caps its (per-minute) rate until that table is empty.
LOGIN_EMAIL_RATE_PER_MIN=2
# EMAIL_DEBUG_RATELIMIT=1
