# Copy to .env.local for local dev, and set the same values in Vercel
# (Project → Settings → Environment Variables). Never commit real secrets.

# --- Supabase (Project → Settings → API) ---
# Safe to expose to the browser:
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only: full access, used by API routes and the recompute job.
# NEVER prefix with NEXT_PUBLIC and never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Live scores ---
# Server-only. The poller uses this; it must never reach the client.
# football-data.org token (free account) — free final scores for the World Cup.
FOOTBALL_DATA_TOKEN=your-football-data-token

# --- Security ---
# Random secret that the live-score poll endpoint requires, so only our
# scheduler (Supabase cron / external cron) can trigger a poll.
CRON_SECRET=generate-a-long-random-string

# Shared passcode for the /admin results-entry page. If unset, admin access is
# disabled. Pick something only you (and any trusted co-admins) know.
ADMIN_PASSCODE=choose-a-strong-passcode

# Public base URL of the app (used for share links).
NEXT_PUBLIC_APP_URL=https://worldcup.kachwalas.com
